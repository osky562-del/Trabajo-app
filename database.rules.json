{
  "rules": {
    ".read": false,
    ".write": false,
    "usuarios": {
      ".read": "auth != null",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "perfil": {
          ".validate": "newData.hasChildren(['nombre','updatedAt'])"
        },
        "rutas": {
          ".validate": "newData.isList()"
        },
        "tacografo": {
          ".validate": "newData.hasChildren(['today','cfg'])"
        },
        "viajes": {
          "$date": {
            ".validate": "$date.matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/) && newData.hasChildren(['title','start','extendedProps'])"
          }
        }
      }
    }
  }
}

